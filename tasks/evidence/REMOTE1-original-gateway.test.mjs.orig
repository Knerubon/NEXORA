import assert from 'node:assert/strict';
import test from 'node:test';
import { readFileSync } from 'node:fs';

const pageSource = readFileSync(new URL('../app/page.tsx', import.meta.url), 'utf8');
const proxyConfig = readFileSync(new URL('../next.config.mjs', import.meta.url), 'utf8');

test('frontend requests stay on the same origin and no backend address is hard-coded', () => {
  assert.match(pageSource, /const api = "\/api\/nexora";/);
  assert.doesNotMatch(pageSource, /NEXT_PUBLIC_API_BASE_URL|127\.0\.0\.1:8000|192\.168\.1\.128/);
  assert.match(pageSource, /fetch\(`\$\{api\}\$\{p\}`/);
  assert.match(pageSource, /new WebSocket\(`\$\{protocol\}:\/\/\$\{window\.location\.host\}\/api\/nexora\/ws\/events`\)/);
});

test('Next.js proxy forwards browser traffic to the local backend without exposing it', () => {
  assert.match(proxyConfig, /source:\s*"\/api\/nexora"/);
  assert.match(proxyConfig, /destination:\s*"http:\/\/127\.0\.0\.1:8000"/);
  assert.match(proxyConfig, /source:\s*"\/api\/nexora\/:path\*"/);
  assert.match(proxyConfig, /destination:\s*"http:\/\/127\.0\.0\.1:8000\/:path\*"/);
  assert.doesNotMatch(proxyConfig, /allowed_hosts|allowedOrigins|NEXT_PUBLIC/);
});
