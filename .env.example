# P2 connection contract; unused by the P1 scaffold. Supply at runtime only.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nexora
# Required runtime variable names (no values in repository): PGUSER, PGPASSWORD

# Optional local research configuration (paths/DSN supplied at runtime):
# NEXORA_RESEARCH_CONFIG, NEXORA_BACKTEST_CONFIG_DIR, NEXORA_JOURNAL_PATH
# NEXORA_POSTGRES_DSN: required to choose PostgreSQL; never commit its value.
# NEXORA_TEST_POSTGRES_DSN: isolated disposable integration-test database only.
