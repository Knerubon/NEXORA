# Copy to .env.production in the approved stable worktree only.
NEXORA_ENV=production
# Defaults: API 127.0.0.1:8100, Web 127.0.0.1:3100
# Runtime defaults to <this worktree>/.runtime/production
# Optional absolute overrides; every writable path must be under NEXORA_RUNTIME_ROOT:
# NEXORA_RUNTIME_ROOT=
# NEXORA_JOURNAL_PATH=
# NEXORA_STATE_PATH=
# NEXORA_CHECKPOINT_PATH=
# NEXORA_LOG_PATH=
# NEXORA_CACHE_PATH=
# Copy approved research JSON unchanged into this stable worktree before configuring:
# NEXORA_RESEARCH_CONFIG=
# NEXORA_BACKTEST_CONFIG_DIR=
# Optional read-only MT5 source. Preserve the verified existing offset/configuration.
# NEXORA_MT5_PATH=
# NEXORA_MT5_SYMBOL=
# NEXORA_MT5_TIME_OFFSET_SECONDS=0
# PostgreSQL credentials must be supplied locally; separate DB/role + identity required.
# NEXORA_POSTGRES_DSN=
# Secure remote access (REMOTE1): the exact public HTTPS origin exposed through the
# tunnel (e.g. https://nexora.example.com), matching your Cloudflare Tunnel public
# hostname. Not a secret; still opt-in and unset by default - remote access stays
# off until this is set. See tasks/REMOTE1-secure-remote-access.md.
# NEXORA_EXTERNAL_ORIGIN=
