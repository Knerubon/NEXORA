# Copy to .env.development in the DEV worktree. No credentials in this template.
NEXORA_ENV=development
# Defaults: API 127.0.0.1:8000, Web 127.0.0.1:3000
# Runtime defaults to <this worktree>/.runtime/development
# Optional absolute overrides; every writable path must be under NEXORA_RUNTIME_ROOT:
# NEXORA_RUNTIME_ROOT=
# NEXORA_JOURNAL_PATH=
# NEXORA_STATE_PATH=
# NEXORA_CHECKPOINT_PATH=
# Research recovery checkpoints (ADR-022) live in the checkpoint path above;
# on by default. "off" forces full journal replay on every start.
# NEXORA_RESEARCH_CHECKPOINTS=on
# NEXORA_LOG_PATH=
# NEXORA_CACHE_PATH=
# Copy the existing research JSON unchanged into this worktree before configuring:
# NEXORA_RESEARCH_CONFIG=
# Optional ADR-023 feature JSON inside this worktree/runtime; unset = all DISABLED.
# Pattern Engine permits DISABLED or SHADOW only; changes take effect on restart.
# NEXORA_FEATURES_CONFIG=
# NEXORA_BACKTEST_CONFIG_DIR=
# Optional read-only MT5 market source (same source is allowed in both environments):
# NEXORA_MT5_PATH=
# NEXORA_MT5_SYMBOL=
# NEXORA_MT5_TIME_OFFSET_SECONDS=0
# PostgreSQL credentials must be supplied locally; separate DB/role + identity required.
# NEXORA_POSTGRES_DSN=
